# =============================================================================
# AUTOBOUTIQUE PHUKET - PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกข้อมูลจริงสำหรับเชื่อมต่อระบบภายนอก
# =============================================================================

# 1. LINE OFFICIAL ACCOUNT & MESSAGING API
# ขอได้จาก: https://developers.line.biz/ (Messaging API Channel)
# ใช้สำหรับ: ส่งข้อความแจ้งเตือนยืนยันคิว ยอดเงิน และอัปเดตสเต็ปงาน 5 ขั้นตอนหาลูกค้าทาง LINE อัตโนมัติ
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"
LINE_DEFAULT_USER_ID="YOUR_LINE_USER_ID_OR_ADMIN_GROUP_ID"

# 2. LINE FRONT-END FRAMEWORK (LIFF)
# ขอได้จาก: https://developers.line.biz/ (LIFF Tab)
# ใช้สำหรับ: ฝังเว็บแอปนี้ลงใน Rich Menu ของ LINE OA ให้ลูกค้าเปิดจองได้ทันที 1 คลิกโดยไม่ต้องล็อกอินซ้ำ
NEXT_PUBLIC_LIFF_ID="YOUR_LINE_LIFF_ID_HERE"

# 3. THAI BANK SLIP VERIFICATION API (ระบบตรวจจับสลิปอัตโนมัติ)
# ผู้ให้บริการแนะนำ: EasySlip (https://easyslip.com/) หรือ SlipOK (https://slipok.com/)
# ใช้สำหรับ: สแกนตรวจ QR บนสลิปธนาคาร ยืนยันยอดเงิน ฿500 และเลขบัญชีผู้รับแบบเรียลไทม์
SLIP_VERIFY_API_KEY="YOUR_SLIP_VERIFY_API_KEY_HERE"
SLIP_VERIFY_BRANCH_ID="YOUR_SLIP_VERIFY_BRANCH_ID"

# 4. STORE PAYMENT & CONTACT CONFIGURATION
# ข้อมูลบัญชีพร้อมเพย์และเบอร์ติดต่อสตูดิโอ
NEXT_PUBLIC_PROMPTPAY_NUMBER="0966369933"
NEXT_PUBLIC_STUDIO_NAME="Autoboutique Phuket (หจก. ซี-คิวบ์ ออโตโมทีฟ)"
NEXT_PUBLIC_STUDIO_PHONE="0966369933"

# 5. CLOUD DATABASE (สำหรับซิงค์ข้อมูลคิวและโควตาแพ็คเกจแบบ Real-time)
# แนะนำ: Supabase (https://supabase.com/) หรือ Neon PostgreSQL
# ใช้สำหรับ: บันทึกข้อมูลคิวและประวัติแพ็คเกจลงฐานข้อมูลจริงแทน LocalStorage
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# 6. APP BASE URL
# โดเมนที่ใช้งานจริง (สำหรับสร้าง Webhook และ Callback URL)
NEXT_PUBLIC_BASE_URL="https://booking.autoboutiqueth.com"
